# Copy to .env.local and fill in. Server-only — never prefix any of these with NEXT_PUBLIC_.

# DeepSeek (Unit 09). Leave blank to use the offline fallback parser.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Supabase → Project Settings → API keys
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Simulated device check PIN
DEMO_PIN=1234

# Protects /api/demo/* and /api/simulate/*. Any long random string.
DEMO_ADMIN_KEY=
